# Скопируйте в .env в корне репозитория и заполните. Файл .env НЕЛЬЗЯ коммитить и отправлять в чаты.

DOMAIN=lawtracker.example.ru
BASE_URL=https://lawtracker.example.ru
POSTGRES_PASSWORD=                      # openssl rand -hex 24

# Боевой режим
APP_ENV=production
DEMO_MODE=false
COOKIE_SECURE=true
AUTO_CREATE_TABLES=false
ADMIN_TOKEN=                            # openssl rand -hex 24  (48 символов)
BETA_INVITE_ONLY=true
ENFORCE_PLAN_LIMITS=false               # в бете все видят все функции
TZ_NAME=Europe/Moscow
TERMS_VERSION=2026-11-draft             # после утверждения текстов юристом: например 2026-12-01

# Почта (SMTP вашего провайдера; SPF/DKIM/DMARC — см. deploy/INSTRUCTIONS.md)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=LawTracker <noreply@lawtracker.example.ru>
SUPPORT_EMAIL=support@lawtracker.example.ru

# Telegram (необязательно)
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=                # openssl rand -hex 16
ALERT_TELEGRAM_CHAT_ID=                 # ваш chat_id: алерты об ошибках сервера

# ИИ-разбор актов (одно из двух)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_BUNDLE=/srv/certs/russian_trusted_root_ca.pem   # если TLS-проверка GigaChat падает (см. deploy/INSTRUCTIONS.md)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
ANALYSIS_PASSES=2

# Как часто искать новые акты, секунд
INGEST_INTERVAL=3600
